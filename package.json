{
  "name": "price-tag-generator",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://tomegz.github.io/price-tag-generator/",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "emulators:start": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:docker": "docker compose up firebase-emulators",
    "emulators:docker:build": "docker compose build firebase-emulators",
    "emulators:docker:down": "docker compose down",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.17.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
